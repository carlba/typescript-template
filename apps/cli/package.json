{
  "name": "@carlba/cli",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "cli": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build-watch": "tsc --watch",
    "start": "tsx dist/cli.js",
    "start:dev": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "prepare": "pnpm --filter @carlba/core... run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint ."
  },
  "dependencies": {
    "@carlba/config": "workspace:*",
    "@carlba/core": "workspace:*",
    "@carlba/logger": "workspace:*",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  }
}
