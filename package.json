{
  "name": "typescript-template",
  "description": "A short project description",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "author": "carlba",
  "homepage": "https://github.com/carlba/typescript-template",
  "bugs": {
    "url": "https://github.com/carlba/typescript-template"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:carlba/typescript-template"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run --if-present test:coverage",
    "start": "node --env-file-if-exists=.env apps/cli/dist/cli.js",
    "start:dev": "tsx --env-file-if-exists=.env apps/cli/src/cli.ts",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dependency:update": "pnpm up -r --latest \"!typescript\" \"!vitest\" \"!@types/node\"",
    "linux:install": "docker run --rm --platform linux/amd64 -e CI=\"true\" -v \"$PWD\":/app -w /app node:24-bullseye bash -lc \"corepack enable && corepack prepare pnpm@11.5.1 --activate && pnpm install\"",
    "linux:ci": "docker run --rm --platform linux/amd64 -e CI=\"true\" -v \"$PWD\":/app -w /app node:24-bullseye bash -lc \"corepack enable && corepack prepare pnpm@11.5.1 --activate && pnpm install --frozen-lockfile && pnpm run lint && pnpm run test && pnpm run build\""
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
