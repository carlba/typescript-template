{
  "name": "typescript-template",
  "description": "A short project description",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "author": "carlba",
  "homepage": "https://github.com/carlba/typescript-template",
  "bugs": {
    "url": "https://github.com/carlba/typescript-template"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:carlba/typescript-template"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run --if-present test:coverage",
    "start:dev": "pnpm --filter @carlba/cli start:dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "linux:install": "docker run --rm --platform linux/amd64 -v \"$PWD\":/app -w /app node:24-bullseye bash -lc \"corepack enable && corepack prepare pnpm@11.5.1 --activate && pnpm install\"",
    "linux:ci": "docker run --rm --platform linux/amd64 -v \"$PWD\":/app -w /app node:24-bullseye bash -lc \"corepack enable && corepack prepare pnpm@11.5.1 --activate && pnpm install --frozen-lockfile && pnpm run lint && pnpm run test && pnpm run build\"",
    "cli:build": "pnpm --filter @carlba/cli build",
    "cli:dev": "pnpm --filter @carlba/cli start:dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
